{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aat.invalid/hazard-summary.schema.json",
  "title": "HazardSummary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hazard_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "enum": [
        "BMKG",
        "PVMBG",
        "SATELIT",
        "SENSOR_PANTAI"
      ]
    },
    "hazard_type": {
      "enum": [
        "SEISMIC",
        "VOLCANIC",
        "WILDFIRE",
        "COASTAL"
      ]
    },
    "severity": {
      "enum": [
        "NORMAL",
        "WASPADA",
        "SIAGA",
        "AWAS"
      ]
    },
    "area_name": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "hazard_id",
    "source",
    "hazard_type",
    "severity",
    "area_name",
    "occurred_at",
    "ingested_at"
  ],
  "oneOf": [
    {
      "properties": {
        "source": {
          "const": "BMKG"
        },
        "hazard_type": {
          "const": "SEISMIC"
        }
      }
    },
    {
      "properties": {
        "source": {
          "const": "PVMBG"
        },
        "hazard_type": {
          "const": "VOLCANIC"
        }
      }
    },
    {
      "properties": {
        "source": {
          "const": "SATELIT"
        },
        "hazard_type": {
          "const": "WILDFIRE"
        }
      }
    },
    {
      "properties": {
        "source": {
          "const": "SENSOR_PANTAI"
        },
        "hazard_type": {
          "const": "COASTAL"
        }
      }
    }
  ]
}
