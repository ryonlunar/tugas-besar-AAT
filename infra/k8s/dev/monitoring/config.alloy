discovery.kubernetes "applications" {
  role = "pod"
  namespaces {
    names = ["sistem-informasi-kebencanaan-bnpb"]
  }
}

discovery.relabel "applications" {
  targets = discovery.kubernetes.applications.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex = "Running"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label = "service"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_role", "__meta_kubernetes_pod_label_application"]
    regex = "store;spilo"
    target_label = "service"
    replacement = "postgres"
  }
  rule {
    source_labels = ["service"]
    regex = "bmkg-mock|pvmbg-mock|aggregator|auth|client-api|dashboard-consumer|notifier-consumer|nats|postgres|postgres-operator|tempo"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
}

loki.source.kubernetes "applications" {
  targets = discovery.relabel.applications.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
