{
  "uid": "aat-infrastructure",
  "title": "AAT \u00b7 System activity",
  "tags": [
    "aat",
    "m1"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Application readiness",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ready/Not ready comes from /ready. Unknown means metrics could not be scraped, for example after stopping the container. Readiness does not imply fresh source data.",
      "targets": [
        {
          "refId": "A",
          "expr": "(aat_service_ready{service=~\"$service\"} and on(service) (up{job=~\"applications|third-consumer\",service=~\"$service\"} == 1)) or on(service) (up{job=~\"applications|third-consumer\",service=~\"$service\"} - 1)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ],
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "NATS availability",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "JetStream health reported by the NATS monitoring endpoint.",
      "targets": [
        {
          "refId": "A",
          "expr": "((gnatsd_healthz_js_enabled_only_status_value{value=\"ok\"} or on(service) (0 * up{job=\"nats\"})) and on(service) (up{job=\"nats\"} == 1)) or on(service) (up{job=\"nats\"} - 1)",
          "legendFormat": "NATS",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ],
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Source freshness",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Fresh = last cycle succeeded within the configured threshold. Stale = failure or age threshold exceeded. Unavailable = no successful ingestion yet.",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(source) (aat_source_state{state=\"fresh\"}) + 2 * sum by(source) (aat_source_state{state=\"stale\"})) and on() (aat_store_collection_success == 1) and on() (up{service=\"aggregator\"} == 1)",
          "legendFormat": "{{source}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Fresh",
                  "color": "green"
                },
                "2": {
                  "text": "Stale",
                  "color": "orange"
                }
              }
            }
          ],
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Time since successful ingestion",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Age of the last successfully ingested snapshot, not the age of the hazard itself. No value before the first success.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - aat_source_last_success_timestamp_seconds",
          "legendFormat": "{{source}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Storage metrics readable",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "0 means collection failed; queue and inbox values are omitted rather than reported as zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "aat_store_collection_success",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "aat_consumer_store_collection_success{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Read failed",
                  "color": "red"
                },
                "1": {
                  "text": "Readable",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "API traffic by response",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Includes authorization failures and rate limiting. Health probes are excluded.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status) (rate(aat_http_requests_total{service=\"client-api\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Successful API reads \u00b7 p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Server-side histogram estimate, split by requested source. Compare load-test results separately; no traffic means no percentile.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,source) (rate(aat_http_request_duration_seconds_bucket{service=\"client-api\",route=~\"/v1/hazards.*\",status=~\"2..\"}[$__rate_interval])))",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Source polling",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A cycle includes source reads, mapping and persistence. Failed cycles remain visible even if the API serves stale data.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(peer,outcome) (rate(aat_operations_total{operation=\"source_poll\"}[$__rate_interval]))",
          "legendFormat": "{{peer}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Auth traffic by response",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Login and refresh responses are shown separately. This panel never exposes credentials or tokens.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route,status) (rate(aat_http_requests_total{service=\"auth\"}[$__rate_interval]))",
          "legendFormat": "{{route}} \u00b7 {{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Outbox awaiting publication",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Includes scheduled retries. A growing queue with failed publishes indicates delivery is blocked.",
      "targets": [
        {
          "refId": "A",
          "expr": "aat_outbox_pending",
          "legendFormat": "Pending events",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Publication attempts",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A successful publish means a JetStream acknowledgement was received. Retries can include the same event.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(outcome) (rate(aat_operations_total{operation=\"jetstream_publish\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Consumer backlog",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pending = not yet delivered. Awaiting ACK = delivered but not acknowledged. Retention can remove events; a lower backlog alone does not prove all effects committed.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(consumer_name, stream_name) (jetstream_consumer_num_pending{is_consumer_leader=\"true\"}) and on() (gnatsd_healthz_js_enabled_only_status_value{value=\"ok\"} == 1) and on() (up{job=\"nats\"} == 1)",
          "legendFormat": "{{consumer_name}} \u00b7 pending",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by(consumer_name, stream_name) (jetstream_consumer_num_ack_pending{is_consumer_leader=\"true\"}) and on() (gnatsd_healthz_js_enabled_only_status_value{value=\"ok\"} == 1) and on() (up{job=\"nats\"} == 1)",
          "legendFormat": "{{consumer_name}} \u00b7 awaiting ACK",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Consumer ACK attempts",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Successful ACKs are broker-confirmed attempts, not a count of unique business effects.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,outcome) (rate(aat_operations_total{operation=\"ack\",service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Committed consumer records",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Persistent unique valid messages in each private inbox. Survives container restarts.",
      "targets": [
        {
          "refId": "A",
          "expr": "aat_consumer_inbox_messages{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Quarantined messages",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Persistent unique invalid messages. Open consumer logs to investigate validation or storage failures.",
      "targets": [
        {
          "refId": "A",
          "expr": "aat_consumer_quarantine_messages{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "title": "Process uptime",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Resets when the application process restarts. Missing metrics do not prove the container stopped.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=~\"applications|third-consumer\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "title": "Go heap usage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Application Go heap only; this does not measure total container RAM.",
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_alloc_bytes{job=~\"applications|third-consumer\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
