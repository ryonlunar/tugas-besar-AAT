# Baseline contract v1. Blank secrets must be generated locally.
# Inject only the variables each service owns; never the whole file everywhere.
COMPOSE_PROJECT_NAME=aat

# Listener ports: update corresponding base URLs if changed.
BMKG_MOCK_HTTP_PORT=8081
PVMBG_MOCK_HTTP_PORT=8082
API_HTTP_PORT=8080
AGGREGATOR_HTTP_PORT=8083
AUTH_HTTP_PORT=8084
DASHBOARD_HTTP_PORT=8085
NOTIFIER_HTTP_PORT=8086
BMKG_BASE_URL=http://bmkg-mock:8081
PVMBG_BASE_URL=http://pvmbg-mock:8082
AGGREGATOR_BASE_URL=http://aggregator:8083

# Independent source/internal trust domains. No active secrets committed.
BMKG_API_KEY=
PVMBG_TOKEN=
AGGREGATOR_API_KEY=
CONSUMER_DEMO_KEY=

# Sources and polling
MOCK_SEED_COUNT=20
MOCK_EVENT_INTERVAL=10s
BMKG_DELAY_MS=100
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_SCHEMA_VERSION=1
# 1-2 kompatibel (M1); 3 rename alert_level->level; 4 eruption_count_24h string; 5 ash_column_height_m hilang
PVMBG_OUTAGE_ENABLED=false
SOURCE_POLL_INTERVAL=5s
BMKG_REQUEST_TIMEOUT=1s
PVMBG_REQUEST_TIMEOUT=4s
SOURCE_RESPONSE_MAX_BYTES=1048576
SOURCE_STALE_AFTER=15s

# Aggregator-owned PostgreSQL. No host port published.
# Compose fixes HOST/PORT; these two values also support direct binary runs.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aat
POSTGRES_USER=aat_aggregator
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
DB_READ_MAX_CONNS=10
DB_BMKG_WRITE_MAX_CONNS=2
DB_PVMBG_WRITE_MAX_CONNS=2
DB_RELAY_MAX_CONNS=2
DB_READ_TIMEOUT=200ms
DB_WRITE_TIMEOUT=2s

# Client API and internal read path
API_MAX_INFLIGHT=128
AGGREGATOR_MAX_INFLIGHT=128
AGGREGATOR_REQUEST_TIMEOUT=1s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_IDLE_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=5s

# Optional metrics listener; the k3s development profile uses :9091.
METRICS_ADDR=

# Auth: three distinct local secrets, RS256 private/public files.
MEDIA_CLIENT_SECRET=
FIELD_TEAM_CLIENT_SECRET=
BNPB_INTERNAL_CLIENT_SECRET=
ACCESS_TOKEN_TTL=60s
REFRESH_TOKEN_TTL=24h
JWT_ISSUER=aat-auth
JWT_AUDIENCE=aat-client-api
# Compose fixes key/state paths below; override them for direct binary runs.
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem
AUTH_STATE_PATH=/data/auth.db
AUTH_MAX_INFLIGHT=16
AUTH_BODY_MAX_BYTES=8192
AUTH_READ_TIMEOUT=2s

# NATS private event domain. Monitoring stays internal; access via compose exec.
# Compose fixes NATS_URL and consumer state paths; direct binary runs may override them.
NATS_URL=nats://nats:4222
NATS_TOKEN=
NATS_STREAM_NAME=HAZARD_EVENTS
NATS_DASHBOARD_DURABLE=dashboard-v1
NATS_NOTIFIER_DURABLE=notifier-v1
NATS_MAX_AGE=24h
NATS_MAX_BYTES=268435456
NATS_MAX_MSGS=100000
NATS_MAX_MSG_SIZE=65536
NATS_DUPLICATE_WINDOW=2m
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=64
NATS_MAX_DELIVER=-1
NATS_FETCH_BATCH=10
NATS_FETCH_EXPIRES=2s
NATS_PUBLISH_TIMEOUT=2s
CONSUMER_NAK_DELAY=5s
DASHBOARD_STATE_PATH=/data/dashboard.db
NOTIFIER_STATE_PATH=/data/notifier.db

# Aggregator outbox relay
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_PENDING=10000
OUTBOX_RETRY_MIN=1s
OUTBOX_RETRY_MAX=30s

# M2 replicated profile. Empty SHARD_CONFIG_FILE keeps the single PostgreSQL path.
AGGREGATOR_DISCOVERY_HOST=
SHARD_CONFIG_FILE=
SOURCE_SESSION_IDLE_TIMEOUT=10s
SOURCE_RETRY_INTERVAL=2s
NATS_STREAM_REPLICAS=1
# Optional OTLP/HTTP tracing. The k3s multi-node profile uses Tempo and 3 stream replicas.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.01

# M2 durable intake (replicated profile). Audit token is issued by the assistant.
AUDIT_TOKEN=
INGEST_PROCESSING_ENABLED=true

# PVMBG schema adaptation registry (D3). Kosong = kebijakan ketat (park); isi
# hanya setelah review, dengan nama dipisah koma: level_alias,
# eruption_count_string, ash_height_optional. Lihat docs/m2-pvmbg-schema-policy.md.
PVMBG_SCHEMA_ADAPTERS=

# Feed Satelit (SAT.*, FIRE.*, MAP.*, P4.*). Kosong (keduanya) = satelit
# nonaktif; hanya diaktifkan bila repository adalah profil sharded
# (SATELLITE_REQUIRES_SHARDED_PROFILE bila tidak). SATELLITE_TOKEN TIDAK
# di-generate acak oleh prepare.py dan TIDAK masuk ConfigMap runtime.env --
# nilainya diberikan kelompok lewat Secret eksternal (.secrets/satellite-secret.yaml).
SATELLITE_BASE_URL=
SATELLITE_TOKEN=
# Batas keterlambatan event-time (D7) -- hipotesis, lihat docs/m2-satellite-feed-notes.md §6.
SATELLITE_ALLOWED_LATENESS=12h
SATELLITE_BATCH_MAX_EVENTS=200
SATELLITE_BATCH_MAX_BYTES=262144
SATELLITE_BATCH_MAX_WAIT=250ms
SATELLITE_IDLE_TIMEOUT=30s
SATELLITE_RECONNECT_MIN=500ms
SATELLITE_RECONNECT_MAX=30s
SATELLITE_REQUEST_TIMEOUT=5s
SATELLITE_SESSION_POLL_INTERVAL=5s

# Impor katalog BMKG historis (P1.1a, D11). Kosong = dilewati; fixture
# sintetis berlabel SYNTHETIC sampai dataset resmi tersedia (lihat Fase 7).
BMKG_HISTORICAL_CATALOG_FILE=
