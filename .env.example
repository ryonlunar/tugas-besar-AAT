# Baseline contract v1. Blank secrets must be generated locally.
# Inject only the variables each service owns; never the whole file everywhere.
APP_ENV=development
LOG_LEVEL=info
COMPOSE_PROJECT_NAME=aat

# Listener ports: update corresponding base URLs if changed.
BMKG_MOCK_HTTP_PORT=8081
PVMBG_MOCK_HTTP_PORT=8082
API_HTTP_PORT=8080
AGGREGATOR_HTTP_PORT=8083
AUTH_HTTP_PORT=8084
DASHBOARD_HTTP_PORT=8085
NOTIFIER_HTTP_PORT=8086
BMKG_BASE_URL=http://bmkg-mock:8081
PVMBG_BASE_URL=http://pvmbg-mock:8082
AGGREGATOR_BASE_URL=http://aggregator:8083
AUTH_BASE_URL=http://auth:8084

# Independent source/internal trust domains. No active secrets committed.
BMKG_API_KEY=
PVMBG_TOKEN=
AGGREGATOR_API_KEY=
CONSUMER_DEMO_KEY=

# Sources and polling
MOCK_SEED_COUNT=20
MOCK_EVENT_INTERVAL=10s
BMKG_DELAY_MS=100
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_SCHEMA_VERSION=1
PVMBG_OUTAGE_ENABLED=false
SOURCE_POLL_INTERVAL=5s
BMKG_REQUEST_TIMEOUT=1s
PVMBG_REQUEST_TIMEOUT=4s
SOURCE_RESPONSE_MAX_BYTES=1048576
SOURCE_STALE_AFTER=15s

# Aggregator-owned PostgreSQL. NO host port published.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aat
POSTGRES_USER=aat_aggregator
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
DB_READ_MAX_CONNS=10
DB_BMKG_WRITE_MAX_CONNS=2
DB_PVMBG_WRITE_MAX_CONNS=2
DB_RELAY_MAX_CONNS=2
DB_READ_TIMEOUT=200ms
DB_WRITE_TIMEOUT=2s

# Client API and internal read path
API_MAX_INFLIGHT=128
AGGREGATOR_MAX_INFLIGHT=128
AGGREGATOR_REQUEST_TIMEOUT=1s
API_DEFAULT_LIMIT=50
API_MAX_LIMIT=100
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_IDLE_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=5s
CORRELATION_ID_HEADER=X-Correlation-ID

# Auth: three distinct local secrets, RS256 private/public files.
MEDIA_CLIENT_SECRET=
FIELD_TEAM_CLIENT_SECRET=
BNPB_INTERNAL_CLIENT_SECRET=
ACCESS_TOKEN_TTL=60s
REFRESH_TOKEN_TTL=24h
JWT_ISSUER=aat-auth
JWT_AUDIENCE=aat-client-api
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem
AUTH_STATE_PATH=/data/auth.db
AUTH_MAX_INFLIGHT=16
AUTH_BODY_MAX_BYTES=8192
AUTH_READ_TIMEOUT=2s

# NATS private event domain. Monitoring stays internal; access via compose exec.
NATS_URL=nats://nats:4222
NATS_TOKEN=
NATS_STREAM_NAME=HAZARD_EVENTS
NATS_DASHBOARD_DURABLE=dashboard-v1
NATS_NOTIFIER_DURABLE=notifier-v1
NATS_MAX_AGE=24h
NATS_MAX_BYTES=268435456
NATS_MAX_MSGS=100000
NATS_MAX_MSG_SIZE=65536
NATS_DUPLICATE_WINDOW=2m
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=64
NATS_MAX_DELIVER=-1
NATS_FETCH_BATCH=10
NATS_FETCH_EXPIRES=2s
NATS_PUBLISH_TIMEOUT=2s
CONSUMER_NAK_DELAY=5s
DASHBOARD_STATE_PATH=/data/dashboard.db
NOTIFIER_STATE_PATH=/data/notifier.db

# Aggregator outbox relay
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_PENDING=10000
OUTBOX_RETRY_MIN=1s
OUTBOX_RETRY_MAX=30s
