# Docker build contexts need only the shared Go module and these three services.
# In particular, never send local environment files or unrelated project artifacts.
*
!go.mod
!go.sum
!contracts/
!contracts/*.go
!contracts/*.json
!pkg/
!pkg/jetstreamconsumer/
!pkg/jetstreamconsumer/**
!services/
!services/aggregator/
!services/aggregator/**
!services/bmkg-mock/
!services/bmkg-mock/**
!services/pvmbg-mock/
!services/pvmbg-mock/**
!services/dashboard-consumer/
!services/dashboard-consumer/**
!services/notifier-consumer/
!services/notifier-consumer/**
